# GovBiz Finder 환경변수 예시. 실제 값은 .env.local(커밋 금지) 또는 서버 비밀 저장소에 설정.

# --- 필수(운영) ---
# 32바이트 이상 임의 문자열(base64). 사업자번호 AES-GCM 암호화 키. 생성: openssl rand -base64 32
APP_ENCRYPTION_KEY=
# 사업자번호 정확일치 인덱스(HMAC) 키. 암호화 키와 다른 값 사용. 생성: openssl rand -base64 32
APP_HMAC_KEY=
# 세션 토큰 해시용 pepper. 생성: openssl rand -base64 32
APP_SESSION_PEPPER=

# --- 선택 ---
# 로컬 SQLite 파일 경로 (기본 ./data/dev.sqlite). 테스트는 :memory: 사용
DATABASE_PATH=./data/dev.sqlite
# 국세청 사업자등록정보 상태조회 API 인증키(공공데이터포털 발급). 비어 있으면 mock adapter(테스트 데이터 표시)
NTS_API_KEY=
# 사이트 기준 URL (canonical/sitemap/Origin 검사). 예: https://example.com
SITE_URL=http://localhost:3000
# 이메일 발송 공급자 (미설정 시 앱 내 알림만 사용)
EMAIL_PROVIDER=
# 개발 전용: 기업 관계 확인을 자동 승인(운영에서는 절대 true 금지)
DEV_AUTO_APPROVE_COMPANY=false
# 개발 전용 관리자 시드 비밀번호 (db:seed 시 사용, 미설정 시 임의 생성 후 1회 출력)
SEED_ADMIN_PASSWORD=
