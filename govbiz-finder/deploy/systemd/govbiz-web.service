[Unit]
Description=GovBiz Finder web
After=network-online.target
Wants=network-online.target

[Service]
User=govbiz
WorkingDirectory=/opt/govbiz/current
EnvironmentFile=/opt/govbiz/shared/.env
ExecStart=/usr/bin/npm start -- -p 3000 -H 127.0.0.1
Restart=always
RestartSec=5
MemoryMax=1200M
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
