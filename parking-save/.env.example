# ParkingSave 환경변수 예시. 실제 값은 .env.local(커밋 금지) 또는 서버 비밀 저장소에 설정. 배포는 docs/DEPLOYMENT.md

# 로컬 SQLite 파일 경로 (기본 ./data/dev.sqlite, 컨테이너 기본 /data/parking.sqlite). 테스트는 :memory:
DATABASE_PATH=./data/dev.sqlite
# 목업 데이터: 미설정 시 개발·테스트에서만 켜지고 운영(production)에서는 꺼짐. 명시하려면 true/false
PARKING_MOCK_DATA=
# 네이버 지도 URL Scheme의 appname(모바일 웹은 웹 페이지 URL)과 canonical 기준. 운영 도메인으로 설정
SITE_URL=http://localhost:3000

# 공공데이터포털 인증키(전국주차장정보표준데이터 15012896, 특일 정보 15012690 공용). Encoding(%3D%3D로 끝남)/Decoding 어느 형태든 가능(자동 정규화)
DATA_GO_KR_SERVICE_KEY=
# 표준데이터 페이지 크기(선택, 기본 100)
STANDARD_PAGE_SIZE=
# 서울 열린데이터광장 인증키(시영주차장 실시간). 비어 있으면 서울 수집 job 비활성
SEOUL_OPENAPI_KEY=
# 서울 API 기준 URL(선택). 문서 예시는 http://openapi.seoul.go.kr:8088 — https 지원 여부 미확인
SEOUL_OPENAPI_BASE=

# 관리자 API 토큰(32자 이상 무작위 문자열). 비어 있거나 짧으면 POST /api/admin/sync 비활성. 생성: openssl rand -base64 32
ADMIN_API_TOKEN=
# 감사로그 클라이언트 해시용 솔트(선택)
ADMIN_AUDIT_SALT=
# 앱 앞 프록시 단계 수(기본 1, 로드밸런서만이면 1, CDN+로드밸런서면 2). 요청 제한의 클라이언트 식별에 사용(docs/DEPLOYMENT.md 4절)
TRUSTED_PROXY_COUNT=
