# ParkingSave 환경변수 예시. 실제 값은 .env.local(커밋 금지) 또는 서버 비밀 저장소에 설정.
# 로컬 SQLite 파일 경로 (기본 ./data/dev.sqlite). 테스트는 :memory:
DATABASE_PATH=./data/dev.sqlite
# 네이버 지도 URL Scheme의 appname(모바일 웹은 웹 페이지 URL)과 canonical 기준. 운영 도메인으로 설정
# 공공데이터포털 인증키(전국주차장정보표준데이터 등). 미발급 — 원천 검증 전까지 비워 둠
DATA_GO_KR_SERVICE_KEY=
SITE_URL=http://localhost:3000
