{
  "blog_name": "myblog",
  "chrome_profile_dir": "./chrome_profile",
  "posts_dir": "./posts",
  "published_dir": "./posts/published",
  "failed_dir": "./posts/failed",
  "default_category": "",
  "default_visibility": "public",
  "posts_per_run": 1,
  "headless": false,
  "wait_between_posts_sec": 30,
  "ai": {
    "model": "claude-opus-5-5",
    "effort": "medium",
    "min_chars": 2000,
    "title_candidates": 8,
    "quality_gate": true,
    "self_check": true,
    "sns": true,
    "style_prompt": ""
  },
  "timezone": "Asia/Seoul",
  "thumbnail": {
    "enabled": true,
    "footer": "",
    "font": ""
  },
  "schedule": {
    "slots": [
      "09:00"
    ],
    "skip_weekdays": [],
    "gap_hours": 24
  }
}